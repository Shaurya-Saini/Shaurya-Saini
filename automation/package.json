{
  "name": "github-profile-stats",
  "version": "1.0.0",
  "private": true,
  "description": "Self-hosted, pre-generated GitHub profile stats SVGs served from a Cloudflare Worker + KV.",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "preview": "tsx scripts/preview.ts",
    "preview:mock": "tsx scripts/preview.ts --mock",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20240925.0",
    "@types/node": "^22.20.1",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2",
    "vitest": "^2.1.1",
    "wrangler": "^3.78.0"
  }
}
